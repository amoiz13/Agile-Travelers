# Copy to .env (ignored by Git) and fill in real values. Never commit .env.
RESROBOT_API_KEY=API_KEY_HERE
GEMINI_API_KEY=API_KEY_HERE

# Optional. Comma-separated, tried in order; the next one is used on 404/503.
GEMINI_MODELS=gemini-3.6-flash,gemini-flash-latest

# Optional tuning (defaults shown).
PORT=8787
RESROBOT_TIMEOUT_MS=8000
GEMINI_TIMEOUT_MS=20000
CACHE_TTL_SECONDS=300
TRIPS_CACHE_TTL_SECONDS=60
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60
# Set to 1 when running behind a reverse proxy so client IPs are read correctly.
TRUST_PROXY=0
